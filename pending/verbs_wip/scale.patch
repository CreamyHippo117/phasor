+def test_stretch_points_scale_about_the_pivot():
+    p = stretch_points([[2.0, 3.0, 1.0]], np.array([0.5, 2.0, 1.0]), np.array([1.0, 1.0, 0.0]))
+    assert p.tolist() == [[1.5, 5.0, 1.0]]
