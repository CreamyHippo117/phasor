+        assert xs.min() / size[0] == pytest.approx(x0, abs=0.02)
+        assert (xs.max() + 1) / size[0] == pytest.approx(x1, abs=0.02)
+        assert ys.min() / size[1] == pytest.approx(y0, abs=0.03)
+        assert (ys.max() + 1) / size[1] == pytest.approx(y1, abs=0.03)
