+                                f"[{old.index}]; follow one feature per object")  # fmt: skip
+        ramp = min(0.25 * spec["duration"], d / 2)
+        path = f"{probe}.on"
+        ops.append(self._span(path, 1.0, "follow", 0.0, ramp, spec["ease"]))
+        ops.append(self._span(path, 0.0, "follow", d - ramp, d, spec["ease"]))
