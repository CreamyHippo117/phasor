+def _clock(**kw):
+    s = Scene("coset", passes=None)
+    s.add(algebra.ClockDiagram(id="clock", n=12, step=4, **kw))
+    s.marker("a", 1.0)
+    s.marker("b", 5.0)
+    return s
+
+
+def _points(e, t, object_id="clock"):
+    state = e.state_at(t)
+    return state[object_id].impl.features(state)["points" if object_id == "clock" else "nodes"]
