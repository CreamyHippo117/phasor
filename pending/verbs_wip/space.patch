 def _resample(points: np.ndarray, n: int) -> np.ndarray:
     pts = np.asarray(points, dtype=np.float64)
     cum = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))])
